@{
    ViewData["Title"] = "Shop unavailable";
    var unavailable = Context.Response.StatusCode == StatusCodes.Status503ServiceUnavailable;
}

<div class="alert alert-warning mt-4">
    @if (unavailable)
    {
        <h4 class="alert-heading">The shop is temporarily unavailable</h4>
        <p class="mb-0">We couldn't reach the Shop API. Please try again in a moment.</p>
    }
    else
    {
        <h4 class="alert-heading">Something went wrong</h4>
        <p class="mb-0">@ViewData["Message"]</p>
    }
</div>

<a href="@Context.Request.Path@Context.Request.QueryString" class="btn btn-primary">Try again</a>
<a asp-controller="Home" asp-action="Index" class="btn btn-link">Back to home</a>
