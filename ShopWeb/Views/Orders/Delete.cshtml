@model OrderDto
@{
    ViewData["Title"] = $"Delete order #{Model.Id}";
}

<h1>Delete order #@Model.Id</h1>
<p>Are you sure you want to delete this order? Its order lines will be deleted too.</p>

<dl class="row">
    <dt class="col-sm-3">Customer</dt>
    <dd class="col-sm-9">@Model.CustomerName</dd>
    <dt class="col-sm-3">Order date</dt>
    <dd class="col-sm-9">@Model.OrderDate.ToString("d MMM yyyy")</dd>
    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9"><partial name="_StatusBadge" model="Model.Status" /></dd>
    <dt class="col-sm-3">Items</dt>
    <dd class="col-sm-9">@Model.ItemCount</dd>
    <dt class="col-sm-3">Total</dt>
    <dd class="col-sm-9">@Model.Total.ToString("C")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-link" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
</form>
