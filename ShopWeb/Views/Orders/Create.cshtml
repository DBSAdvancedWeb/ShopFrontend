@model ShopWeb.Models.Shop.CreateOrderViewModel
@using System.Globalization
@{
    ViewData["Title"] = "New order";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">My orders</a></li>
        <li class="breadcrumb-item active" aria-current="page">New order</li>
    </ol>
</nav>

<h1 class="mb-4">New order</h1>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger"></div>
}

@if (!Model.Lines.Any())
{
    <div class="alert alert-info">There are no items to order yet.</div>
}
else
{
    <form method="post" asp-action="Create">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Item</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">In stock</th>
                    <th class="text-end" style="width: 10rem">Quantity</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Lines.Count; i++)
                {
                    var line = Model.Lines[i];
                    <tr>
                        <td>
                            @line.Name
                            <input type="hidden" asp-for="Lines[i].ItemId" />
                        </td>
                        <td class="text-end">@line.Price.ToString("C")</td>
                        <td class="text-end">@line.StockQuantity</td>
                        <td>
                            <input asp-for="Lines[i].Quantity" type="number" min="0"
                                   max="@Math.Min(line.StockQuantity, 1000)"
                                   class="form-control form-control-sm text-end js-qty"
                                   data-price="@line.Price.ToString(CultureInfo.InvariantCulture)" />
                            <span asp-validation-for="Lines[i].Quantity" class="text-danger small"></span>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-semibold">
                    <td colspan="3" class="text-end">Estimated total</td>
                    <td class="text-end" id="estimated-total">@Model.EstimatedTotal.ToString("C")</td>
                </tr>
            </tfoot>
        </table>

        <p class="text-muted small">Prices and stock are confirmed by the shop when you place the order.</p>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Place order</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Live estimate only; the API sets the real prices
        const fmt = new Intl.NumberFormat('en-IE', { style: 'currency', currency: 'EUR' });
        const inputs = document.querySelectorAll('.js-qty');
        const totalCell = document.getElementById('estimated-total');

        function updateTotal() {
            let total = 0;
            inputs.forEach(i => total += (parseInt(i.value, 10) || 0) * parseFloat(i.dataset.price));
            if (totalCell) totalCell.textContent = fmt.format(total);
        }

        inputs.forEach(i => i.addEventListener('input', updateTotal));
    </script>
}
