@model OrderListViewModel
@{
    ViewData["Title"] = "My orders";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">My orders</h1>
    <a class="btn btn-primary" asp-action="Create">New order</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-4">
    <div class="col-md-4">
        <select name="status" class="form-select">
            <option value="">All statuses</option>
            @foreach (var s in Model.Statuses)
            {
                if (string.Equals(s, Model.SelectedStatus, StringComparison.OrdinalIgnoreCase))
                {
                    <option value="@s" selected>@s</option>
                }
                else
                {
                    <option value="@s">@s</option>
                }
            }
        </select>
    </div>
    <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (!Model.Orders.Any())
{
    <div class="alert alert-info">You have no orders yet.</div>
}
else
{
    <p class="text-muted">@Model.Orders.Count order(s), worth @Model.TotalValue.ToString("C") in total</p>
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Order #</th>
                <th>Date</th>
                <th>Customer</th>
                <th>Status</th>
                <th class="text-end">Items</th>
                <th class="text-end">Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model.Orders)
            {
                <tr>
                    <td class="fw-semibold">@o.Id</td>
                    <td>@o.OrderDate.ToString("d MMM yyyy")</td>
                    <td>@o.CustomerName</td>
                    <td><partial name="_StatusBadge" model="o.Status" /></td>
                    <td class="text-end">@o.ItemCount</td>
                    <td class="text-end">@o.Total.ToString("C")</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
