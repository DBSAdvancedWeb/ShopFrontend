@model ItemListViewModel
@{
    ViewData["Title"] = "Items";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Items</h1>
    <a class="btn btn-primary" asp-action="Create">New item</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-4">
    <div class="col-md-6">
        <input type="search" name="search" value="@Model.Search"
               class="form-control" placeholder="Search items..." />
    </div>
    <div class="col-md-6 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (!Model.Items.Any())
{
    <div class="alert alert-info">
        @(string.IsNullOrWhiteSpace(Model.Search) ? "No items yet." : "No items match your search.")
    </div>
}
else
{
    <p class="text-muted">@Model.Items.Count item(s)</p>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (ItemDto item in Model.Items)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text text-muted small flex-grow-1">@item.Description</p>
                        <div class="d-flex justify-content-between align-items-baseline">
                            <strong>@item.Price.ToString("C")</strong>
                            <span class="small text-muted">@item.StockQuantity in stock</span>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">View details</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary ms-auto">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
